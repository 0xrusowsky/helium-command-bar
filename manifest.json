{
  "manifest_version": 3,
  "name": "Helium Command Bar",
  "version": "0.26.0",
  "description": "Search tabs, create splits, and navigate Helium's split-aware tab blocks from the keyboard.",
  "homepage_url": "https://github.com/0xrusowsky/helium-command-bar",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "bookmarks",
    "favicon",
    "scripting",
    "search",
    "sessions",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Helium Command Bar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-command-bar": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Open the command bar"
    },
    "cycle-split-pane": {
      "suggested_key": {
        "default": "Ctrl+Shift+Up",
        "mac": "MacCtrl+Shift+Up"
      },
      "description": "Focus the next pane in the current split"
    },
    "previous-split-pane": {
      "description": "Focus the previous pane in the current split"
    },
    "next-tab-block": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right",
        "mac": "MacCtrl+Shift+Right"
      },
      "description": "Focus the next tab block"
    },
    "previous-tab-block": {
      "description": "Focus the previous tab block"
    },
    "promote-preview-tab": {
      "suggested_key": {
        "default": "Ctrl+O",
        "mac": "Command+MacCtrl+O"
      },
      "description": "Move the current preview tab into the main Helium window"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
