{
  "title": "Helium Keyboard Tools — Numbered Navigation",
  "rules": [
    {
      "description": "Use Command-1 through Command-9 for split-aware tab blocks in Helium",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "1", "modifiers": { "mandatory": ["command"], "optional": ["caps_lock"] } },
          "to": [{ "key_code": "1", "modifiers": ["option", "shift"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^net\\.imput\\.helium$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "2", "modifiers": { "mandatory": ["command"], "optional": ["caps_lock"] } },
          "to": [{ "key_code": "2", "modifiers": ["option", "shift"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^net\\.imput\\.helium$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "3", "modifiers": { "mandatory": ["command"], "optional": ["caps_lock"] } },
          "to": [{ "key_code": "3", "modifiers": ["option", "shift"] }],
